<?xml version="1.0" encoding="utf-8"?>
<!-- Android backup and phone-to-phone transfer (Android 12+): same rules as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
    <exclude domain="sharedpref" path="secrets.xml" />
    <exclude domain="file" path="logs/" />
    </cloud-backup>
    <device-transfer>
    <exclude domain="sharedpref" path="secrets.xml" />
    <exclude domain="file" path="logs/" />
    </device-transfer>
</data-extraction-rules>
