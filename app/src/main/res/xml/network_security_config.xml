<?xml version="1.0" encoding="utf-8"?>
<!-- Every connection must be HTTPS, checked against the system's trusted certificates only
     (certificates users install themselves aren't trusted). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
